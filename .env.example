# Optional: the default environment for calls that name no environment-name. Without it the server uses
# the environments registered in clio's appsettings.json, and clio's active one as the default.
# Choose exactly one authentication mode. Never commit a populated .env file.
CREATIO_URL=https://example.invalid

# Forms authentication
CREATIO_LOGIN=example-user
CREATIO_PASSWORD=replace-me

# OAuth client credentials (instead of forms credentials)
# CREATIO_CLIENT_ID=replace-me
# CREATIO_CLIENT_SECRET=replace-me
# CREATIO_AUTH_APP_URI=https://identity.example.invalid/connect/token

# Set true only for a Creatio environment whose service URLs omit the legacy /0 prefix.
CREATIO_IS_NET_CORE=false
