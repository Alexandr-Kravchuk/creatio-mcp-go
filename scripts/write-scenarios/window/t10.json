[
  {
    "label": "entity business rules: create, read back, update, read back, delete, read back",
    "why": "T10, window-only: every successful business-rule save ends with WorkspaceExplorerService.svc/BuildConfiguration, a stand-wide static-content rebuild that broadcasts ConfigurationStructureChanged to every online user, so it must not run while other agents use the stand. The rules live on an entity in a package the run creates. create-package needs clio master (not in clio 8.1.0.134) and this server's T15 port; create-entity-schema needs the T8 port. Block uIds are passed explicitly so both sides read back the same identities. The package itself has no delete tool and stays on the stand (report it).",
    "steps": [
      {"kind": "write", "label": "package", "tool": "create-package", "clio-run": true,
       "creates": "UsrParity{run}{side}Pkg",
       "go-tool-missing": "create-package is not ported yet (T15) and needs clio master; remove this key when both are available",
       "args": {"package-name": "UsrParity{run}{side}Pkg", "dependencies": ["CrtBase"], "description": "Created by scripts/compare-mcp-writes.py; safe to delete"}},
      {"kind": "write", "label": "entity", "tool": "create-entity-schema", "clio-run": true,
       "creates": "UsrParity{run}{side}Ent",
       "go-tool-missing": "create-entity-schema is not ported yet (T8); remove this key when it is",
       "args": {"package-name": "UsrParity{run}{side}Pkg", "schema-name": "UsrParity{run}{side}Ent",
                "title-localizations": {"en-US": "Parity {run} {side}"},
                "columns": [
                  {"column-name": "UsrAmount", "type": "Integer"},
                  {"column-name": "UsrNote", "type": "ShortText"},
                  {"column-name": "UsrAccount", "type": "Lookup", "reference-schema-name": "Account"}
                ]}},
      {"kind": "cleanup", "for": "UsrParity{run}{side}Ent", "server": "own",
       "calls": [{"tool": "delete-schema", "clio-run": true, "args": {"schema-name": "UsrParity{run}{side}Ent", "remote": true}}]},
      {"kind": "write", "label": "create-rules", "tool": "create-entity-business-rules", "clio-run": true,
       "creates": "UsrParity{run}{side}Rule",
       "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent",
                "rules": [{"caption": "Parity {run} {side}", "name": "UsrParity{run}{side}Rule",
                           "condition": {"logicalOperation": "AND", "conditions": [
                             {"uId": "a1000000-0000-4000-8000-000000000001", "comparisonType": "greater-than",
                              "leftExpression": {"type": "AttributeValue", "path": "UsrAmount", "uId": "a1000000-0000-4000-8000-000000000002"},
                              "rightExpression": {"type": "Const", "value": 10, "uId": "a1000000-0000-4000-8000-000000000003"}}]},
                           "actions": [{"type": "make-required", "items": ["UsrNote"], "uId": "a1000000-0000-4000-8000-000000000004"},
                                       {"type": "set-values", "uId": "a1000000-0000-4000-8000-000000000005", "items": [
                                         {"uId": "a1000000-0000-4000-8000-000000000006",
                                          "expression": {"type": "AttributeValue", "path": "UsrNote", "uId": "a1000000-0000-4000-8000-000000000007"},
                                          "value": {"type": "Const", "value": "parity-value", "uId": "a1000000-0000-4000-8000-000000000008"}}]}]}]}},
      {"kind": "cleanup", "for": "UsrParity{run}{side}Rule", "server": "own",
       "why": "The scenario deletes the rule itself; the read first finds whether it is still there, and an empty capture counts as removed.",
       "calls": [{"tool": "read-entity-business-rules",
                  "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent"},
                  "capture": {"rule": "$.rules[0].name"}},
                 {"tool": "delete-entity-business-rules", "clio-run": true,
                  "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent", "rule-names": ["UsrParity{run}{side}Rule"]}}]},
      {"kind": "read-back", "label": "read-created", "tool": "read-entity-business-rules",
       "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent"}},
      {"kind": "expect", "step": "read-created", "path": "$.count", "equals": 1},
      {"kind": "expect", "step": "read-created", "path": "$.rules[0].name", "equals": "UsrParity{run}{side}Rule"},
      {"kind": "write", "label": "update-rules", "tool": "update-entity-business-rules", "clio-run": true,
       "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent",
                "rules": [{"caption": "Parity {run} {side} updated", "name": "UsrParity{run}{side}Rule", "enabled": false,
                           "condition": {"logicalOperation": "OR", "conditions": [
                             {"uId": "a1000000-0000-4000-8000-000000000001", "comparisonType": "greater-than",
                              "leftExpression": {"type": "AttributeValue", "path": "UsrAmount", "uId": "a1000000-0000-4000-8000-000000000002"},
                              "rightExpression": {"type": "Const", "value": 20, "uId": "a1000000-0000-4000-8000-000000000003"}},
                             {"uId": "a1000000-0000-4000-8000-000000000009", "comparisonType": "is-filled-in",
                              "leftExpression": {"type": "AttributeValue", "path": "UsrAccount", "uId": "a1000000-0000-4000-8000-00000000000a"}}]},
                           "actions": [{"type": "make-read-only", "items": ["UsrNote", "UsrAmount"], "uId": "a1000000-0000-4000-8000-000000000004"}]}]}},
      {"kind": "read-back", "label": "read-updated", "tool": "read-entity-business-rules",
       "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent"}},
      {"kind": "expect", "step": "read-updated", "path": "$.rules[0].enabled", "equals": false},
      {"kind": "expect", "step": "read-updated", "path": "$.rules[0].caption", "equals": "Parity {run} {side} updated"},
      {"kind": "write", "label": "delete-rules", "tool": "delete-entity-business-rules", "clio-run": true,
       "target": "UsrParity{run}{side}Rule",
       "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent", "rule-names": ["UsrParity{run}{side}Rule"]}},
      {"kind": "read-back", "label": "read-deleted", "tool": "read-entity-business-rules",
       "args": {"package-name": "UsrParity{run}{side}Pkg", "entity-schema-name": "UsrParity{run}{side}Ent"}}
    ]
  },
  {
    "label": "entity business rules: apply-filter with child rules and apply-static-filter",
    "why": "T10, window-only for the same reason. Covers the autogenerated ClearValue/PopulateValue child rules and the static ESQ filter round trip on an own entity; the child rules are removed with their parent on delete.",
    "steps": [
      {"kind": "write", "label": "package", "tool": "create-package", "clio-run": true,
       "creates": "UsrParity{run}{side}FPkg",
       "go-tool-missing": "create-package is not ported yet (T15) and needs clio master; remove this key when both are available",
       "args": {"package-name": "UsrParity{run}{side}FPkg", "dependencies": ["CrtBase"]}},
      {"kind": "write", "label": "entity", "tool": "create-entity-schema", "clio-run": true,
       "creates": "UsrParity{run}{side}FEnt",
       "go-tool-missing": "create-entity-schema is not ported yet (T8); remove this key when it is",
       "args": {"package-name": "UsrParity{run}{side}FPkg", "schema-name": "UsrParity{run}{side}FEnt",
                "title-localizations": {"en-US": "Parity filter {run} {side}"},
                "columns": [
                  {"column-name": "UsrCountry", "type": "Lookup", "reference-schema-name": "Country"},
                  {"column-name": "UsrAccount", "type": "Lookup", "reference-schema-name": "Account"}
                ]}},
      {"kind": "cleanup", "for": "UsrParity{run}{side}FEnt", "server": "own",
       "calls": [{"tool": "delete-schema", "clio-run": true, "args": {"schema-name": "UsrParity{run}{side}FEnt", "remote": true}}]},
      {"kind": "write", "label": "create-rules", "tool": "create-entity-business-rules", "clio-run": true,
       "creates": "UsrParity{run}{side}Dep",
       "args": {"package-name": "UsrParity{run}{side}FPkg", "entity-schema-name": "UsrParity{run}{side}FEnt",
                "rules": [
                  {"caption": "Dependent {run} {side}", "name": "UsrParity{run}{side}Dep",
                   "condition": {"logicalOperation": "AND", "conditions": []},
                   "actions": [{"type": "apply-filter", "uId": "b1000000-0000-4000-8000-000000000001", "target": "UsrAccount",
                                "targetFilterPath": "Country", "source": "UsrCountry", "clearValue": true, "populateValue": true}]},
                  {"caption": "Static {run} {side}", "name": "UsrParity{run}{side}Static",
                   "condition": {"logicalOperation": "AND", "conditions": []},
                   "actions": [{"type": "apply-static-filter", "uId": "b1000000-0000-4000-8000-000000000002", "targetAttribute": "UsrAccount",
                                "filter": {"logicalOperation": "AND", "filters": [
                                  {"columnPath": "Name", "comparisonType": "CONTAIN", "value": "a"},
                                  {"columnPath": "CreatedOn", "comparisonType": "GREATER", "valueMacros": "PreviousNDays", "valueMacrosArgument": 30}],
                                  "backwardReferenceFilters": [{"referenceColumnPath": "[Contact:Account]"}]}}]}]}},
      {"kind": "cleanup", "for": "UsrParity{run}{side}Dep", "server": "own",
       "calls": [{"tool": "delete-entity-business-rules", "clio-run": true,
                  "args": {"package-name": "UsrParity{run}{side}FPkg", "entity-schema-name": "UsrParity{run}{side}FEnt",
                           "rule-names": ["UsrParity{run}{side}Dep", "UsrParity{run}{side}Static"]}}]},
      {"kind": "read-back", "label": "read-created", "tool": "read-entity-business-rules",
       "args": {"package-name": "UsrParity{run}{side}FPkg", "entity-schema-name": "UsrParity{run}{side}FEnt"}},
      {"kind": "expect", "step": "read-created", "path": "$.count", "equals": 2}
    ]
  },
  {
    "label": "page business rules: create, read back, update, read back",
    "why": "T10, window-only for the same reason. The page is created from BlankPageTemplate (its only element is MainContainer) in a package the run creates; create-page is not ported yet (T9). The condition uses a system variable because a blank page binds no attribute.",
    "steps": [
      {"kind": "write", "label": "package", "tool": "create-package", "clio-run": true,
       "creates": "UsrParity{run}{side}PPkg",
       "go-tool-missing": "create-package is not ported yet (T15) and needs clio master; remove this key when both are available",
       "args": {"package-name": "UsrParity{run}{side}PPkg", "dependencies": ["CrtBase"]}},
      {"kind": "write", "label": "page", "tool": "create-page", "clio-run": true,
       "creates": "UsrParity{run}{side}_BlankPage",
       "go-tool-missing": "create-page is not ported yet (T9); remove this key when it is",
       "args": {"package-name": "UsrParity{run}{side}PPkg", "schema-name": "UsrParity{run}{side}_BlankPage", "template": "BlankPageTemplate"}},
      {"kind": "cleanup", "for": "UsrParity{run}{side}_BlankPage", "server": "own",
       "calls": [{"tool": "delete-schema", "clio-run": true, "args": {"schema-name": "UsrParity{run}{side}_BlankPage", "remote": true}}]},
      {"kind": "write", "label": "create-rules", "tool": "create-page-business-rules", "clio-run": true,
       "creates": "UsrParity{run}{side}PRule",
       "args": {"package-name": "UsrParity{run}{side}PPkg", "page-schema-name": "UsrParity{run}{side}_BlankPage",
                "rules": [{"caption": "Page parity {run} {side}", "name": "UsrParity{run}{side}PRule",
                           "condition": {"logicalOperation": "AND", "conditions": [
                             {"uId": "c1000000-0000-4000-8000-000000000001", "comparisonType": "is-filled-in",
                              "leftExpression": {"type": "SysValue", "sysValueName": "CurrentUser", "uId": "c1000000-0000-4000-8000-000000000002"}}]},
                           "actions": [{"type": "hide-element", "items": ["MainContainer"], "uId": "c1000000-0000-4000-8000-000000000003"}]}]}},
      {"kind": "cleanup", "for": "UsrParity{run}{side}PRule", "server": "own",
       "calls": [{"tool": "delete-page-business-rules", "clio-run": true,
                  "args": {"package-name": "UsrParity{run}{side}PPkg", "page-schema-name": "UsrParity{run}{side}_BlankPage", "rule-names": ["UsrParity{run}{side}PRule"]}}]},
      {"kind": "read-back", "label": "read-created", "tool": "read-page-business-rules",
       "args": {"package-name": "UsrParity{run}{side}PPkg", "page-schema-name": "UsrParity{run}{side}_BlankPage"}},
      {"kind": "expect", "step": "read-created", "path": "$.count", "equals": 1},
      {"kind": "write", "label": "update-rules", "tool": "update-page-business-rules", "clio-run": true,
       "args": {"package-name": "UsrParity{run}{side}PPkg", "page-schema-name": "UsrParity{run}{side}_BlankPage",
                "rules": [{"caption": "Page parity {run} {side} updated", "name": "UsrParity{run}{side}PRule",
                           "condition": {"logicalOperation": "AND", "conditions": [
                             {"uId": "c1000000-0000-4000-8000-000000000001", "comparisonType": "is-filled-in",
                              "leftExpression": {"type": "SysValue", "sysValueName": "CurrentUserContact", "uId": "c1000000-0000-4000-8000-000000000002"}}]},
                           "actions": [{"type": "show-element", "items": ["MainContainer"], "uId": "c1000000-0000-4000-8000-000000000003"}]}]}},
      {"kind": "read-back", "label": "read-updated", "tool": "read-page-business-rules",
       "args": {"package-name": "UsrParity{run}{side}PPkg", "page-schema-name": "UsrParity{run}{side}_BlankPage"}},
      {"kind": "expect", "step": "read-updated", "path": "$.rules[0].caption", "equals": "Page parity {run} {side} updated"}
    ]
  }
]
