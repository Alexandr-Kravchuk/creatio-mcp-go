      {
        "kind": "write",
        "label": "replay",
        "tool": "sync-schemas",
        "clio-run": true,
        "known-differences": [
          "$.dataforge"
        ],
        "args": {
          "package-name": "{pkg}",
          "operations": [
            {
              "type": "create-lookup",
              "schema-name": "UsrParity{run}{side}SyncKind",
