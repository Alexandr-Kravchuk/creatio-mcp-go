                  "type": "MediumText",
                  "title-localizations": {
                    "en-US": "Note"
                  }
                }
              ]
            }
          ]
        }
      },
      {
        "kind": "cleanup",
        "for": "UsrParity{run}{side}Sync",
        "server": "clio",
        "calls": [
          {
            "tool": "delete-schema",
            "clio-run": true,
            "args": {
              "schema-name": "UsrParity{run}{side}Sync",
              "remote": true
            }
          },
          {
            "tool": "execute-esq",
            "clio-run": true,
            "args": {
              "query": {
                "rootSchemaName": "Lookup",
                "operationType": 0,
                "rowCount": 1,
                "columns": {
                  "items": {
                    "Id": {
                      "expression": {
                        "expressionType": 0,
                        "columnPath": "Id"
                      }
                    }
                  }
                },
                "filters": {
                  "filterType": 6,
                  "isEnabled": true,
                  "logicalOperation": 0,
                  "items": {
                    "own": {
                      "filterType": 1,
                      "comparisonType": 3,
                      "isEnabled": true,
                      "leftExpression": {
                        "expressionType": 0,
                        "columnPath": "Name"
                      },
                      "rightExpression": {
                        "expressionType": 2,
                        "parameter": {
                          "dataValueType": 1,
                          "value": "Parity sync kind {run} {side}"
                        }
                      }
                    }
                  }
                }
              }
            },
            "capture": {
              "lookupRowId": "$.rows[0].id"
