          "package-name": "{pkg}",
          "operations": [
            {
              "type": "create-lookup",
              "schema-name": "UsrParity{run}{side}SyncKind",
              "title-localizations": {
                "en-US": "Parity sync kind {run} {side}"
              }
            },
            {
              "type": "create-entity",
              "schema-name": "UsrParity{run}{side}Sync",
              "title-localizations": {
                "en-US": "Parity sync"
              },
              "columns": [
                {
