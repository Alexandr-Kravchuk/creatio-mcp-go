                      },
                      "rightExpression": {
                        "expressionType": 2,
                        "parameter": {
                          "dataValueType": 1,
                          "value": "UsrParity{run}{side}BatchRe"
                        }
                      }
                    }
                  }
                }
              }
            },
            "capture": {
              "cleanupId": "$.rows[0].id"
            }
          },
          {
            "tool": "execute-dataservice-batch",
            "clio-run": true,
            "destructive": true,
            "args": {
              "operations": [
                {
                  "operation": "delete",
                  "schema-name": "Contact",
                  "record-id": "{cleanupId}"
                }
              ]
            }
          }
        ]
      },
      {
        "kind": "write",
        "label": "batch-update",
        "tool": "execute-dataservice-batch",
        "clio-run": true,
        "target": "UsrParity{run}{side}BatchRe",
        "args": {
          "operations": [
            {
              "operation": "update",
              "schema-name": "Contact",
              "record-id": "{id}",
              "values": {
                "Notes": {
                  "data-value-type": 1,
                  "value": "Parity updated"
                }
              }
            }
          ]
        }
      },
      {
        "kind": "read-back",
        "label": "read-updated",
        "tool": "execute-esq",
        "clio-run": true,
        "args": {
          "query": {
            "rootSchemaName": "Contact",
            "operationType": 0,
            "rowCount": 1,
            "columns": {
              "items": {
                "Id": {
