                  }
                },
                "Notes": {
                  "expression": {
                    "expressionType": 0,
                    "columnPath": "Notes"
                  }
                }
              }
            },
            "filters": {
              "filterType": 6,
              "isEnabled": true,
              "logicalOperation": 0,
              "items": {
                "own": {
                  "filterType": 1,
                  "comparisonType": 3,
                  "isEnabled": true,
                  "leftExpression": {
                    "expressionType": 0,
                    "columnPath": "Name"
                  },
