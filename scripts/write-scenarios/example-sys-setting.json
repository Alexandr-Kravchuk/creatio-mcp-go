[
  {
    "label": "create-sys-setting text, read back, remove",
    "why": "Creates only a run-owned setting; DataService cleanup is required because this stand returns HTTP 405 to OData DELETE.",
    "steps": [
      {"kind": "write", "label": "create", "tool": "create-sys-setting", "clio-run": true,
       "creates": "UsrParity{run}{side}Setting",
       "args": {"code": "UsrParity{run}{side}Setting", "name": "Parity {run} {side}",
                "value-type-name": "ShortText", "value": "parity-value",
                "description": "Created by scripts/compare-mcp-writes.py; safe to delete"}},
      {"kind": "cleanup", "for": "UsrParity{run}{side}Setting", "server": "clio",
       "why": "Find the own row and delete it through native DataService. The T12 live run separately checks whether this cascades to SysSettingsValue.",
       "calls": [
         {"tool": "execute-esq", "clio-run": true,
          "args": {"query": {"rootSchemaName": "SysSettings", "operationType": 0, "rowCount": 1,
            "columns": {"items": {"Id": {"expression": {"expressionType": 0, "columnPath": "Id"}}}},
            "filters": {"filterType": 6, "logicalOperation": 0, "isEnabled": true,
              "items": {"byCode": {"filterType": 1, "comparisonType": 3, "isEnabled": true,
                "leftExpression": {"expressionType": 0, "columnPath": "Code"},
                "rightExpression": {"expressionType": 2, "parameter": {"dataValueType": 1,
                  "value": "UsrParity{run}{side}Setting"}}}}}}},
          "capture": {"id": "$.rows[0].id"}},
         {"tool": "execute-dataservice-batch", "clio-run": true,
          "args": {"operations": [{"operation": "delete", "schema-name": "SysSettings", "record-id": "{id}"}]}}
       ]},
      {"kind": "read-back", "label": "read", "tool": "get-sys-setting",
       "args": {"code": "UsrParity{run}{side}Setting"}},
      {"kind": "expect", "step": "read", "path": "$.value", "equals": "parity-value"},
      {"kind": "expect", "step": "read", "path": "$.code", "equals": "UsrParity{run}{side}Setting"}
    ]
  }
]
