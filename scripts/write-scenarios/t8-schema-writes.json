[
  {
    "label": "C# source designer create update read delete",
    "why": "T8 (create-schema, update-schema). Writes into a package the run creates; never into a stock package.",
    "steps": [
      {
        "kind": "write",
        "label": "create-app",
        "tool": "create-app",
        "server": "clio",
        "clio-run": true,
        "creates": "UsrParity{run}{side}App",
        "retry-while": "temporarily unavailable",
        "retry-seconds": 300,
        "args": {
          "name": "Parity {run} {side} App",
          "code": "Parity{run}{side}App",
          "template-code": "AppFreedomUI",
          "with-mobile-pages": false,
          "description": "Created by scripts/compare-mcp-writes.py; safe to delete"
        },
        "capture": {
          "pkg": "$.packagename",
          "pkguid": "$.packageuid",
          "appuid": "$.applicationid"
        },
        "known-differences": [
          "$.applicationname",
          "$.entities[0].caption",
          "$.entities[0].uid",
          "$.pages[0].uid",
          "$.pages[1].uid",
          "$.pages[2].uid",
          "$.dataforge.warnings[0]",
          "$.dataforge.warnings[1]"
        ],
        "why": "The schema needs a package of its own. Setup through clio on both sides, as in t9-client-unit.json; ids and the display name differ per side."
      },
      {
        "kind": "cleanup",
        "for": "UsrParity{run}{side}App",
        "server": "clio",
        "why": "Uninstalling the application removes its package and everything left in it.",
        "calls": [
          {
            "tool": "delete-app",
            "clio-run": true,
            "args": {
              "app-name": "UsrParity{run}{side}App"
            }
          }
        ]
      },
      {
        "kind": "write",
        "label": "create",
        "tool": "create-schema",
        "clio-run": true,
        "creates": "UsrParity{run}{side}Source",
        "args": {
          "schema-name": "UsrParity{run}{side}Source",
          "package-name": "{pkg}"
        },
        "capture": {
          "schemauid": "$.schemauid"
        }
      },
      {
        "kind": "cleanup",
        "for": "UsrParity{run}{side}Source",
        "server": "clio",
        "calls": [
          {
            "tool": "delete-schema",
            "clio-run": true,
            "args": {
              "schema-name": "UsrParity{run}{side}Source",
              "remote": true
            }
          }
        ]
      },
      {
        "kind": "write",
        "label": "update",
        "tool": "update-schema",
        "clio-run": true,
        "args": {
          "schema-name": "UsrParity{run}{side}Source",
          "body": "namespace Terrasoft.Configuration { public class UsrParityProbe {} }"
        }
      },
      {
        "kind": "read-back",
        "label": "read",
        "tool": "get-schema",
        "args": {
          "schema-name": "UsrParity{run}{side}Source"
        },
        "clio-run": true,
        "why": "get-schema and get-sql-schema are write-capable in clio 8.1.0.142 (a direct call answers confirmation-required), so the read goes through clio-run on both sides."
      },
      {
        "kind": "expect",
        "step": "read",
        "path": "$.body",
        "equals": "namespace Terrasoft.Configuration { public class UsrParityProbe {} }"
      }
    ]
  },
