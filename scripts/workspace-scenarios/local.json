[
 {
  "name": "create-workspace",
  "steps": [
   {
    "tool": "create-workspace",
    "args": {
     "workspaceName": "ws",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "existing non-empty",
    "args": {
     "workspaceName": "ws",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "no directory, no workspaces-root",
    "args": {
     "workspaceName": "w2"
    }
   },
   {
    "tool": "create-workspace",
    "label": "relative directory",
    "args": {
     "workspaceName": "w3",
     "directory": "base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "missing directory",
    "args": {
     "workspaceName": "w4",
     "directory": "{home}/nowhere"
    }
   },
   {
    "tool": "create-workspace",
    "label": "rooted name",
    "args": {
     "workspaceName": "/abs",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "escaping name",
    "args": {
     "workspaceName": "../out",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "blank name",
    "args": {
     "workspaceName": " ",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "no args",
    "args": {}
   },
   {
    "tool": "create-workspace",
    "label": "wrong type",
    "args": {
     "workspaceName": 5,
     "directory": "{home}/base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "case-insensitive keys",
    "args": {
     "WORKSPACENAME": "w5",
     "Directory": "{home}/base"
    }
   },
   {
    "tool": "create-workspace",
    "label": "nested name",
    "args": {
     "workspaceName": "a/b",
     "directory": "{home}/base"
    }
   }
  ]
 },
 {
  "name": "add-package",
  "steps": [
   {
    "tool": "create-workspace",
    "args": {
     "workspaceName": "ws",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "add-package",
    "args": {
     "name": "Pkg1",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "second package",
    "args": {
     "name": "Abc_2",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "existing package",
    "args": {
     "name": "Pkg1",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "invalid name",
    "args": {
     "name": "1bad",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "lone underscore",
    "args": {
     "name": "_",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "71 characters",
    "args": {
     "name": "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "blank prefix",
    "args": {
     "name": "Pkg3",
     "as-app": true,
     "schema-name-prefix": " ",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "prefix without as-app",
    "args": {
     "name": "Pkg4",
     "schema-name-prefix": "Usr",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "wrong as-app type",
    "args": {
     "name": "Pkg5",
     "as-app": "yes",
     "workspace-path": "{ws}"
    }
   }
  ]
 },
 {
  "name": "add-package-as-app",
  "steps": [
   {
    "tool": "create-workspace",
    "args": {
     "workspaceName": "ws",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "add-package",
    "label": "as-app, no environment",
    "args": {
     "name": "App1",
     "as-app": true,
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "plain package joins the app",
    "args": {
     "name": "Lib1",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "as-app with prefix",
    "args": {
     "name": "App2",
     "as-app": true,
     "schema-name-prefix": "Usr",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "as-app with empty prefix",
    "args": {
     "name": "App3",
     "as-app": true,
     "schema-name-prefix": "",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "prefix already in name",
    "args": {
     "name": "UsrApp4",
     "as-app": true,
     "schema-name-prefix": "Usr",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "plain package, two app descriptors",
    "args": {
     "name": "Lib2",
     "workspace-path": "{ws}"
    }
   }
  ]
 },
 {
  "name": "add-package-environment",
  "maintainer": "Acme",
  "stand": {
   "rules": [
    {
     "route": "DataService/json/SyncReply/QuerySysSettings",
     "body": "{\"success\":true,\"values\":{\"SchemaNamePrefix\":{\"value\":\"Abc\"}}}"
    },
    {
     "route": "DataService/json/SyncReply/SelectQuery",
     "contains": "SysPackage",
     "body": "{\"success\":true,\"rows\":[]}"
    }
   ]
  },
  "steps": [
   {
    "tool": "create-workspace",
    "args": {
     "workspaceName": "ws",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "add-package",
    "label": "as-app, prefix from the environment",
    "args": {
     "name": "App1",
     "as-app": true,
     "environment-name": "fake",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "add-package",
    "label": "unknown environment",
    "args": {
     "name": "App2",
     "as-app": true,
     "environment-name": "nope",
     "workspace-path": "{ws}"
    }
   }
  ],
  "known-differences": [
   "sysSettingsNameCollection"
  ]
 },
 {
  "name": "test-projects",
  "steps": [
   {
    "tool": "create-workspace",
    "args": {
     "workspaceName": "ws",
     "directory": "{home}/base"
    }
   },
   {
    "tool": "add-package",
    "args": {
     "name": "Pkg1",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "new-test-project",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{ws}",
     "environment-name": "fake"
    }
   },
   {
    "tool": "new-test-project",
    "label": "again",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{ws}",
     "environment-name": "fake"
    }
   },
   {
    "tool": "new-test-project",
    "label": "missing package",
    "args": {
     "package-name": "Nope",
     "workspace-path": "{ws}",
     "environment-name": "fake"
    }
   },
   {
    "tool": "new-test-project",
    "label": "empty package",
    "args": {
     "package-name": "",
     "workspace-path": "{ws}",
     "environment-name": "fake"
    }
   },
   {
    "tool": "new-test-project",
    "label": "not a workspace",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{home}/base",
     "environment-name": "fake"
    }
   },
   {
    "tool": "new-test-project",
    "label": "unknown environment",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{ws}",
     "environment-name": "nope"
    }
   },
   {
    "tool": "new-test-project",
    "label": "no environment",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "new-integration-test-project",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "new-integration-test-project",
    "label": "again",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "new-integration-test-project",
    "label": "dotted name, net472",
    "args": {
     "package-name": "Acme.Sales",
     "workspace-path": "{ws}",
     "target-framework": "net472"
    }
   },
   {
    "tool": "new-integration-test-project",
    "label": "keyword",
    "args": {
     "package-name": "class",
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "new-integration-test-project",
    "label": "path in name, bad framework",
    "args": {
     "package-name": "a/b",
     "workspace-path": "{ws}",
     "target-framework": "netcore"
    }
   },
   {
    "tool": "new-integration-test-project",
    "label": "empty name and framework",
    "args": {
     "package-name": "",
     "workspace-path": "{ws}",
     "target-framework": ""
    }
   },
   {
    "tool": "new-integration-test-project",
    "label": "no name",
    "args": {
     "workspace-path": "{ws}"
    }
   },
   {
    "tool": "new-integration-test-project",
    "label": "not a workspace",
    "args": {
     "package-name": "Pkg1",
     "workspace-path": "{home}/base"
    }
   }
  ]
 }
]